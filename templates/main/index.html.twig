{% extends 'base.html.twig' %}

{% block title %}Acceuil{% endblock %}

{% block body %}
<main class="main1">
    <section class="section1">
        <div class="container-xxl">
            <div class="row">
                <div class="col">
                    <h1 class="harmonie1">Retrouvez L’équilibre et l’harmonie</h1>
                    <h1 class="harmonie2">avec la médecine chinoise</h1>

                </div>

            </div>
            <div class="row">
                <div class="col">
                    <h2 class="harmonie3">Une approche holistique millénaire pour votre bien-être physique et mental
                    </h2>
                </div>

            </div>
            <div class="col btndiv">
               <a href={{path('main_consultation')}}><button class="btn2">Prendre rendez-vous</button></a> 
                <a href={{path('main_medecine')}}><button class="btn3">Découvrir les soins que je proposes</button></a>
            </div>

        </div>
    </section>
    <section>
        <div class="container-xxl">
            <div class="row">
                <div class="col">
                    <h2 class="titre1h2"> Qu'est-ce que la Médecine Traditionnelle Chinoise ?</h2>
                </div>

            </div>
            <div class="row">
                <hr class="border-top border-5 border-success opacity-100 mx-auto my-4 hr1" style="width:270px;">
            </div>
            <div class="row">
                <div class="col">
                    <p class="paragraphe1">Une approche holistique millénaire qui considère le corps et l'esprit
                        comme un tout
                        interconnecté, visant </p>
                    <p class="paragraphe2">à rétablir l'équilibre énergétique pour favoriser la santé et le
                        bien-être.</p>
                </div>
            </div>
        </div>
        </div>
    </section>
    <section>
        <div class="container-xxl">
            <div class="row line1">
                <div class="card card1" style="width: 18rem;">
                    <a href="{{ path('main_histoire')}}#lienprincipefondamentaux" class="deletedecoration"><img src="../img/principe fondamentaux medecine chinoise.png" class="rounded-5 img2 mx-3"
                        alt="image2">
                    <div class="card-body">
                        <h5 class="card-title navbar-brand card2"> <img
                                src="../img/yin-yang-solid-full pour dossier projet.svg" alt="logo1" height="22"
                                width="22"> &nbsp; les principes fondamentaux</h5>
                        <p class="card-text my-0 card22">Basée sur les concepts de Yin et Yang, des Cinq Éléments et
                            de la
                            circulation du Qi (énergie vitale) à travers les méridiens du corps.</p>
                    </div></a>
                </div>
                <div class="card card1" style="width: 18rem;">
                    <a href="{{ path('main_histoire')}}#lienhistoireettradition" class="deletedecoration"><img src="../img/image histoire et tradition1.png" class="rounded-5 img2 mx-3" alt="image2">
                    <div class="card-body">
                        <h5 class="card-title navbar-brand card2"> <img
                                src="../img/yin-yang-solid-full pour dossier projet.svg" alt="logo1" height="22">
                            &nbsp; Histoire et tradition</h5>
                        <p class="card-text cardbis">Développée en Chine il y a plus de 2500 ans, cette médecine
                            ancestrale
                            continue d'évoluer tout en préservant ses principes fondamentaux.</p>
                    </div></a>
                </div>
                <div class="card card1" style="width: 18rem;">
                    <a href="{{ path('main_histoire')}}#approchepreventive" class="deletedecoration"><img src="../img/image-approche-preventive1.png" class="rounded-5 img2 mx-3" alt="image2">
                    <div class="card-body">
                        <h5 class="card-title navbar-brand card2"> <img
                                src="../img/yin-yang-solid-full pour dossier projet.svg" alt="logo1" height="22">
                            &nbsp; Approche préventive</h5>
                        <p class="card-text cardbis2">Vise à maintenir l'équilibre du corps avant l'apparition de symptômes,
                            en traitant la personne dans sa globalité plutôt que la maladie isolément.</p>
                    </div></a>
                </div>
            </div>

        </div>
    </section>
    <section>
        <div class="container-xxl">
            <div class="row">
                <div class="col">
                    <h2 class="titre2h2"> Les soins que je proposes</h2>
                    <div class="row">
                        <hr class="border-top border-5 border-success opacity-100 mx-auto my-4 hr2"
                            style="width:270px;">
                    </div>
                </div>
            </div>

        </div>
    </section>
    <section>
        <div class="container-xxl d-flex justify-content-center sectiongap1">

            <div class="card sectionsoins1" style="width: 18rem;">
                <a href="{{ path('main_medecine')}}#lienacupuncture" class="deletedecoration"><img src="../img/close-up-needle-hands-physiotherapist-doing-dry-needling 1.png"
                    class="img-thumbnail sectionsoinscolorimg" alt="...">
                <div class="card-body">
                    <h5 class="card-title  cardsectionsoins1"> <img src="../img/aiguille-acunpunture.svg"
                            alt="logo-aiguille" class="logosvg"> &nbsp; Acupuncture
                    </h5>
                    <p class="card-text sectionsoinstext1">Stimulation de points spécifiques du corps à l'aide
                        de
                        fines aiguilles pour
                        rééquilibrer la circulation de l'énergie et soulager divers troubles.</p>

                </div></a>
            </div>

            <div class="card sectionsoins1" style="width: 18rem;">
               <a href="{{ path('main_medecine')}}#lienmassage" class="deletedecoration"> <img src="../img/img massage tuina.png" class="img-thumbnail sectionsoinscolorimg" alt="...">
                <div class="card-body">
                    <h5 class="card-title  cardsectionssoins2"> <img src="../img/masssagechinois.svg" alt=""
                            class="logosvg"> &nbsp;&nbsp; Massage
                        Chinois</h5>
                    <p class="card-text sectionsoinstext2">le «guérisseur» manipule le système des méridiens,
                        composé de points et
                        de voies énergétiques internes, favorisant la circulation du «qi», ou énergie
                        corporelle,
                        et du sang dans tout le corps.</p>

                </div></a>
            </div>
            <div class="card sectionsoins1" style="width: 18rem;">
               <a href="{{ path('main_medecine')}}#lienventouse" class="deletedecoration"> <img src="../img/img ventouse.png" class="img-thumbnail sectionsoinscolorimg" alt="...">
                <div class="card-body">
                    <h5 class="card-title  cardsectionsoins3"> <img src="../img/ventouse2retravailler.svg"
                            alt="" class="logosvg" width="25" height="30"> &nbsp; Ventouse</h5>
                    <p class="card-text sectionsoinstext3">L'utilisation de la ventouse en tant que thérapie est
                        une
                        pseudoscience. Elle se fonde sur le principe qu'un récipient en forme de cloche crée une
                        dépression par effet de succion sur la peau. </p>
                </div></a>
            </div>
            <div class="card sectionsoins1" style="width: 18rem;">
                <a href="{{ path('main_medecine')}}#lienmoxatherapie" class="deletedecoration"><img src="../img/image moxathérapie 1.png" class="img-thumbnail sectionsoinscolorimg" alt="...">
                <div class="card-body">
                    <h5 class="card-title  cardsectionsoins4"> <img src="../img/moxa1logo 1.svg" alt=""
                            width="84px" height="56px" class="logomoxa1"> &nbsp; Moxathérapie</h5>
                    <p class="card-text sectionsoinstext4">La moxibustion est une méthode d’application de
                        chaleur sur des zones
                        déterminées de la peau. C’est une pratique ancestrale puisqu’on la retrouve dans le Nei
                        Jing, le plus ancien ouvrage de MTC.</p>

                </div></a>
            </div>
        </div>

        </div>
    </section>
    <section>
        <div class="container-xxl">
            <div class="row">
                <div class="col-3">
                </div>
                <div class="col-8">
                    <h2 class="apropos1" id="lienapropos">À propos de moi</h2>
                </div>

            </div>
            
                <hr class="border-bottom border-3 border-success opacity-75 hr3" style="width: 145px;">
            
            <div class="row">
                <div class="col-3"></div>
                <div class="col-8">
                    <p class="apropos2">Passionnée par les médecines traditionnelles, j'ai consacré plusieurs années
                        à l'étude
                        approfondie de la Médecine Traditionnelle Chinoise. Mon parcours m'a amenée à me former
                        auprès
                        de maîtres reconnus, tant en France qu'en Chine.</p>
                </div>
            </div>
            <div class="row">
                <div class="col-3"></div>
                <div class="col-8">
                    <p class="apropos3">Mon approche est centrée sur l'écoute et la personnalisation des soins. Je
                        considère chaque
                        patient dans sa globalité, en tenant compte de ses symptômes physiques mais aussi de son
                        équilibre émotionnel et énergétique.</p>
                </div>
            </div>
            <div class="row">
                <div class="col-3"></div>
                <div class="col-9">
                    <p class="apropos4">Je m'engage à vous accompagner dans votre démarche de bien-être et de santé,
                        en vous
                        proposant des solutions adaptées à vos besoins spécifiques.</p>
                </div>
            </div>

            <div class="col apropos6 apropos8"><img src="../img/yin-yang-solid-full pour dossier projet.svg" alt=""
                    height="22px" width="22px"> &nbsp; Aziza kebaier</div>
            <p class="apropos7">Etudiante praticienne en médecine traditionnelle chinoise</p>


        </div>

        </div>




        </div>


        </div>
        </div>
    </section>



</main>
{% endblock %}
